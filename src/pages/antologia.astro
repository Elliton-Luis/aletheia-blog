---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { classify, formatDate } from '../utils/articles';

const allArticles = await getCollection('articles');
// Ordena cronologicamente (Capítulo I ao X)
const articles = allArticles.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

function toRoman(num: number): string {
  const map: [number, string][] = [
    [10, 'X'],
    [9, 'IX'],
    [5, 'V'],
    [4, 'IV'],
    [1, 'I'],
  ];
  let res = '';
  for (const [val, letter] of map) {
    while (num >= val) {
      res += letter;
      num -= val;
    }
  }
  return res;
}

const renderedChapters = await Promise.all(
  articles.map(async (article, idx) => {
    const { Content } = await render(article);
    const meta = classify(article);
    return {
      article,
      Content,
      meta,
      chapterNum: idx + 1,
      roman: toRoman(idx + 1),
    };
  })
);
---

<BaseLayout
  title="Antologia · Volume I"
  description="Edição encadernada reunindo todos os dez ensaios do caderno Aletheia para leitura contínua ou impressão em PDF."
  wide
  showPrint
>
  <header class="page-heading antologia-page-heading">
    <p class="eyebrow">Edição Encadernada</p>
    <h1>Antologia · Volume I</h1>
    <p>Todos os dez ensaios reunidos em volume único. Use o botão «Imprimir» no topo para salvar em PDF.</p>
  </header>

  <div class="antologia-book">
    <!-- CAPA (Página 1 na impressão) -->
    <section class="book-cover">
      <p class="eyebrow">Caderno de Ensaios</p>
      <h2 class="book-title">Aletheia</h2>
      <p class="book-subtitle">Uma Investigação Filosófica sobre Conhecimento, Sociedade e Razão</p>
      <div class="book-cover-meta">
        <p>Volume I · Compilação Completa dos Dez Ensaios</p>
        <p>Por <strong>O Eleito</strong></p>
        <p>2026</p>
      </div>
    </section>

    <!-- PREFÁCIO (Página 2 na impressão) -->
    <section class="book-preface">
      <p class="eyebrow">Prefácio</p>
      <blockquote class="manifesto-quote">
        <p>
          «Em tempos de vazio intelectual, tento trazer meus pensamentos para este espaço.
          Nada do que escrevo aqui é necessariamente verdade, e não há pretensão de rigor acadêmico:
          são pensamentos filosóficos, perguntas e tentativas de compreender o mundo.
        </p>
        <p>
          Aristóteles escreveu sobre a física com os conhecimentos de seu tempo; muitas de suas explicações
          hoje estão superadas. Ainda assim, o valor daquele trabalho não depende apenas de ter acertado.
          Está também no exercício de observar, perguntar e pensar.
        </p>
        <p>
          É esse exercício que quero registrar aqui: um pensamento em processo, sujeito a dúvidas, mudanças e erros.
          O importante não é apenas estar certo, mas se permitir pensar.»
        </p>
        <footer>— O Eleito</footer>
      </blockquote>
    </section>

    <!-- SUMÁRIO GERAL (Página 3 na impressão) -->
    <section class="book-toc">
      <p class="eyebrow">Sumário Geral</p>
      <ol class="book-toc-list">
        {renderedChapters.map(({ article, meta, chapterNum, roman }) => (
          <li>
            <a href={`#capitulo-${chapterNum}`}>
              <span class="toc-roman">Capítulo {roman}</span>
              <span class="toc-title">{article.data.title}</span>
              <span class="toc-dots" aria-hidden="true"></span>
              <span class="toc-meta">{meta.gravitas.label} · {meta.minutes} min</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- OS DEZ CAPÍTULOS -->
    <div class="book-chapters">
      {renderedChapters.map(({ article, Content, meta, chapterNum, roman }) => (
        <article class="book-chapter" id={`capitulo-${chapterNum}`}>
          <header class="chapter-header">
            <p class="post-class">
              Capítulo {roman} · <strong>{meta.name}</strong> · {meta.formatted} caracteres · {meta.gravitas.label} · {meta.minutes} min
            </p>
            <h2 class="chapter-title">{article.data.title}</h2>
            <p class="post-deck">{article.data.description}</p>
            <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
          </header>

          <div class="prose">
            <Content />
          </div>

          {meta.scholia.length > 0 && (
            <section class="post-scholia" aria-label="Scholia deste capítulo">
              <p class="eyebrow">Scholia · Glossário Etimológico <span class="ai-tag">Gerado com auxílio de IA</span></p>
              <dl class="scholia-list">
                {meta.scholia.map((item) => (
                  <div class="scholia-item">
                    <dt><strong>{item.term}</strong> <em class="scholia-etymology">{item.etymology}</em></dt>
                    <dd>{item.meaning}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {(meta.aphorismus || meta.resumo) && (
            <section class="post-summary-section" aria-label="Síntese deste capítulo">
              <p class="eyebrow">Síntese do Ensaio <span class="ai-tag">Resumo feito com auxílio de IA</span></p>
              {meta.aphorismus && (
                <blockquote class="aphorismus-quote">
                  <p>«{meta.aphorismus}»</p>
                </blockquote>
              )}
              {meta.resumo && (
                <p class="summary-text">{meta.resumo}</p>
              )}
            </section>
          )}
        </article>
      ))}
    </div>

    <!-- COLOFÃO FINAL -->
    <footer class="book-colophon">
      <p class="eyebrow">Colofão</p>
      <p>
        Este volume reúne os dez ensaios seminais publicados no caderno digital <strong>Aletheia</strong>.
        Tipografia composta em <em>Literata</em>.
      </p>
      <p class="colophon-credit">© O Eleito</p>
    </footer>
  </div>
</BaseLayout>
