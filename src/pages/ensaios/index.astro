---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { newestFirst, pinnedArticles } from '../../utils/articles';

const articles = newestFirst(await getCollection('articles'));
const pinned = pinnedArticles(articles);
---

<BaseLayout title="Ensaios" description="Todos os ensaios publicados neste caderno, em ordem cronológica.">
  <header class="page-heading archive-heading">
    <p class="eyebrow">Arquivo</p>
    <h1>Ensaios</h1>
    <p>Ideias, leituras e descobertas reunidas ao longo do tempo.</p>
    <p class="archive-anthology-callout">
      <a class="icon-link" href="/antologia/">
        <Icon name="book" />
        <span>Antologia em Volume Único: Ler todos os ensaios ou salvar em PDF &rarr;</span>
      </a>
    </p>
  </header>
  <div class="search-filter" id="search-filter" hidden>
    <label for="search-text" class="sr-only">Buscar por título, descrição ou assunto</label>
    <Icon name="search" />
    <input id="search-text" type="search" placeholder="Buscar por título, descrição ou assunto" autocomplete="off" />
  </div>
  <section class="archive-controls" aria-label="Filtros do arquivo">
    <div class="archive-filters">
      <div class="complexity-filter" id="complexity-filter" hidden>
        <span class="filter-title icon-link"><Icon name="tag" />Complexidade</span>
        <div class="complexity-options" role="radiogroup" aria-label="Filtrar por complexidade">
          <button class="complexity-btn active" type="button" data-complexity="todos" aria-pressed="true">Todos</button>
          <button class="complexity-btn" type="button" data-complexity="simples" aria-pressed="false">Simples</button>
          <button class="complexity-btn" type="button" data-complexity="medio" aria-pressed="false">Médio</button>
          <button class="complexity-btn" type="button" data-complexity="complexo" aria-pressed="false">Complexo</button>
        </div>
      </div>
      <form class="date-filter" id="date-filter" hidden>
        <p class="filter-title icon-link"><Icon name="calendar" />Filtrar por período</p>
        <div class="date-fields">
          <label for="date-from">De
            <input id="date-from" name="from" type="date" />
          </label>
          <label for="date-to">Até
            <input id="date-to" name="to" type="date" />
          </label>
          <button class="clear-filter" type="submit">Aplicar</button>
          <button class="clear-filter" id="clear-dates" type="button">Limpar datas</button>
        </div>
      </form>
    </div>
    <p class="archive-count" id="archive-count" aria-live="polite" hidden></p>
  </section>
  {pinned.length > 0 && (
    <section class="pinned-block" aria-labelledby="fixados">
      <p class="eyebrow icon-link" id="fixados"><Icon name="pin" />Fixados</p>
      <ArticleList articles={pinned} showMonthHeadings={false} />
    </section>
  )}
  <div class="virtual-archive" id="virtual-archive">
    <div class="virtual-spacer" id="top-spacer" aria-hidden="true" hidden></div>
    <div class="virtual-sentinel" id="top-sentinel" aria-hidden="true"></div>
    <button class="archive-more archive-previous" id="load-previous" type="button" hidden>Carregar ensaios anteriores</button>
    <ArticleList articles={articles} />
    <p class="empty-note" id="no-matches" hidden>Nenhum ensaio encontrado.</p>
    <div class="virtual-sentinel" id="bottom-sentinel" aria-hidden="true"></div>
    <button class="archive-more" id="load-more" type="button" hidden>Carregar mais ensaios</button>
    <div class="virtual-spacer" id="bottom-spacer" aria-hidden="true" hidden></div>
  </div>
  <script>
    import '../../scripts/archive.ts';
  </script>
</BaseLayout>
