---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { classify, formatDate, type Article } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const category = classify(article);
const { Content, headings } = await render(article);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={article.data.title} description={article.data.description} wide showPrint>
  <article class="post">
    <header class="post-header">
      <a class="back-link icon-link" href="/ensaios/"><Icon name="arrow-left" />Todos os ensaios</a>
      <p class="post-class" title={`${category.title} · Complexidade: ${category.gravitas.hint}`}>
        <strong>{category.name}</strong> · {category.formatted} caracteres · {category.gravitas.label} · {category.minutes} min
      </p>
      <h1>{article.data.title}</h1>
      <p class="post-deck">{article.data.description}</p>
      <p class="post-meta-line">
        Por <strong>O Eleito</strong> · <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
      </p>
      {article.data.tags.length > 0 && (
        <div class="post-header-tags" aria-label="Assuntos">
          {article.data.tags.map((tag) => (
            <a href={`/assuntos/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )}
      {(category.aphorismus || category.resumo) && (
        <p class="skip-to-summary">
          <a href="#aphorismus">Não tem tempo para ler tudo agora? <strong>Ir direto para a síntese ↓</strong></a>
        </p>
      )}
    </header>
    <div class="post-reading-layout">
      <div class="post-body">
        <div class="prose"><Content /></div>

        {category.scholia.length > 0 && (
          <section class="post-scholia" id="scholia" aria-labelledby="scholia-title">
            <p class="eyebrow" id="scholia-title">
              Scholia · Glossário Etimológico <span class="ai-tag">Gerado com auxílio de IA</span>
            </p>
            <dl class="scholia-list">
              {category.scholia.map((item) => (
                <div class="scholia-item">
                  <dt><strong>{item.term}</strong> <em class="scholia-etymology">{item.etymology}</em></dt>
                  <dd>{item.meaning}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {(category.aphorismus || category.resumo) && (
          <section class="post-summary-section" id="aphorismus" aria-labelledby="aphorismus-title">
            <p class="eyebrow" id="aphorismus-title">
              Síntese do Ensaio <span class="ai-tag">Resumo feito com auxílio de IA</span>
            </p>
            {category.aphorismus && (
              <blockquote class="aphorismus-quote">
                <p>«{category.aphorismus}»</p>
              </blockquote>
            )}
            {category.resumo && (
              <p class="summary-text">{category.resumo}</p>
            )}
          </section>
        )}

        {article.data.tags.length > 0 && (
          <footer class="post-footer">
            <span>Assuntos</span>
            {article.data.tags.map((tag) => <a href={`/assuntos/${encodeURIComponent(tag)}/`}>{tag}</a>)}
          </footer>
        )}
        <p class="post-contact">
          Alguma sugestão de melhoria ou quer só conversar? Entre em contato com{' '}
          <a href="mailto:oeleito.blog@gmail.com">oeleito.blog@gmail.com</a>.
        </p>
      </div>
      {tableOfContents.length > 0 && (
        <aside class="post-toc" aria-label="Títulos deste ensaio">
          <ul class="toc-actions">
            <li><a class="icon-link" href="/ensaios/"><Icon name="arrow-left" />Sair</a></li>
            <li><a class="icon-link" href="#topo"><Icon name="arrow-up" />Ir ao topo</a></li>
          </ul>
          <p class="eyebrow">Neste ensaio</p>
          <nav aria-label="Índice do ensaio">
            <ol class="toc-list">
              {tableOfContents.map((heading) => (
                <li class:list={[`toc-depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} data-heading-id={heading.slug}>{heading.text}</a>
                </li>
              ))}
              {category.scholia.length > 0 && (
                <li class="toc-depth-2 toc-scholion">
                  <a href="#scholia">Scholia (Etimologia)</a>
                </li>
              )}
              {(category.aphorismus || category.resumo) && (
                <li class="toc-depth-2 toc-aphorism">
                  <a href="#aphorismus">Aphorismus & Síntese</a>
                </li>
              )}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </article>
  <script>
    import '../../scripts/toc.ts';
  </script>
</BaseLayout>
