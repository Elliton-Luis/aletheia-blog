---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { classify, formatDate, type Article } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const category = classify(article);
const { Content, headings } = await render(article);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={article.data.title} description={article.data.description} wide showPrint>
  <article class="post">
    <header class="post-header">
      <a class="back-link icon-link" href="/ensaios/"><Icon name="arrow-left" />Todos os ensaios</a>
      <p class="eyebrow">{article.data.tags.join(' · ') || 'Caderno pessoal'}</p>
      <p class="post-class" title={`${category.title} · Gravitas: ${category.gravitas.hint}`}>
        <strong>{category.name}</strong> · {category.formatted} caracteres · Gravitas: {category.gravitas.label} · {category.minutes} min de leitura
      </p>
      <h1>{article.data.title}</h1>
      <p class="post-deck">{article.data.description}</p>
      {(category.aphorismus || category.resumo) && (
        <p class="skip-to-summary">
          Não tem tempo para ler tudo agora?{' '}
          <a href="#aphorismus" class="skip-summary-link">Ir direto para a síntese ↓</a>
        </p>
      )}
      <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
      <p class="post-author">Por <strong>O Eleito</strong></p>
    </header>
    <div class="post-reading-layout">
      <div class="post-body">
        <div class="prose"><Content /></div>

        {category.scholia.length > 0 && (
          <section class="scholia-box" id="scholia" aria-labelledby="scholia-title">
            <div class="scholia-header">
              <span class="scholia-badge">Marginalia & Raízes</span>
              <h2 id="scholia-title">Scholia · Glossário Etimológico</h2>
            </div>
            <dl class="scholia-list">
              {category.scholia.map((item) => (
                <div class="scholia-item">
                  <dt>
                    <strong class="scholia-term">{item.term}</strong>
                    <span class="scholia-etymology">{item.etymology}</span>
                  </dt>
                  <dd class="scholia-meaning">{item.meaning}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {(category.aphorismus || category.resumo) && (
          <section class="aphorismus-box" id="aphorismus" aria-labelledby="aphorismus-title">
            <div class="aphorismus-header">
              <span class="aphorismus-badge">Destilação & Síntese</span>
              <h2 id="aphorismus-title">Aphorismus</h2>
            </div>
            {category.aphorismus && (
              <blockquote class="aphorismus-quote">
                <p>«{category.aphorismus}»</p>
              </blockquote>
            )}
            {category.resumo && (
              <div class="aphorismus-summary">
                <h3 class="summary-title">Síntese Fiel do Ensaio</h3>
                <p>{category.resumo}</p>
              </div>
            )}
          </section>
        )}

        {article.data.tags.length > 0 && (
          <footer class="post-footer">
            <span>Assuntos</span>
            {article.data.tags.map((tag) => <a href={`/assuntos/${encodeURIComponent(tag)}/`}>{tag}</a>)}
          </footer>
        )}
        <p class="post-contact">
          Alguma sugestão de melhoria ou quer só conversar? Entre em contato com{' '}
          <a href="mailto:oeleito.blog@gmail.com">oeleito.blog@gmail.com</a>.
        </p>
      </div>
      {tableOfContents.length > 0 && (
        <aside class="post-toc" aria-label="Títulos deste ensaio">
          <ul class="toc-actions">
            <li><a class="icon-link" href="/ensaios/"><Icon name="arrow-left" />Sair</a></li>
            <li><a class="icon-link" href="#topo"><Icon name="arrow-up" />Ir ao topo</a></li>
          </ul>
          <p class="eyebrow">Neste ensaio</p>
          <nav aria-label="Índice do ensaio">
            <ol class="toc-list">
              {tableOfContents.map((heading) => (
                <li class:list={[`toc-depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} data-heading-id={heading.slug}>{heading.text}</a>
                </li>
              ))}
              {category.scholia.length > 0 && (
                <li class="toc-depth-2 toc-scholion">
                  <a href="#scholia">Scholia (Etimologia)</a>
                </li>
              )}
              {(category.aphorismus || category.resumo) && (
                <li class="toc-depth-2 toc-aphorism">
                  <a href="#aphorismus">Aphorismus & Síntese</a>
                </li>
              )}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </article>
  <script>
    import '../../scripts/toc.ts';
  </script>
</BaseLayout>
