---
import { getCollection } from 'astro:content';
import ArticleList from '../components/ArticleList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { newestFirst, pinnedArticles } from '../utils/articles';

const articles = newestFirst(await getCollection('articles'));
const pinned = pinnedArticles(articles);
---

<BaseLayout title="Um espaço para pensar" description="Pensamentos, reflexões, estudos e descobertas reunidos em um caderno pessoal.">
  {pinned.length > 0 && (
    <section class="pinned-block" aria-labelledby="fixados">
      <p class="eyebrow icon-link" id="fixados"><Icon name="pin" />Fixados</p>
      <ArticleList articles={pinned} showMonthHeadings={false} />
    </section>
  )}
  <section class="home-feed" aria-labelledby="recentes">
    <div class="section-heading">
      <div><p class="eyebrow">Aletheia</p><h1 id="recentes">Publicações recentes</h1></div>
      <a class="text-link icon-link" href="/ensaios/">Ver todos <Icon name="arrow-right" /></a>
    </div>
    <ArticleList articles={articles.slice(0, 5)} />
  </section>

  <aside class="home-note" aria-labelledby="consideracoes">
    <p class="eyebrow" id="consideracoes">Considerações</p>
    <p>Um espaço pessoal para registrar o que penso, estudo, leio e descubro. Ensaios sem a pretensão de encerrar assunto — apenas de acompanhá-lo por um tempo.</p>
    <a class="text-link icon-link" href="/sobre/">Sobre este espaço <Icon name="arrow-right" /></a>
  </aside>
</BaseLayout>
