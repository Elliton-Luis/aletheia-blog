---
import '../styles/global.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import Icon from '../components/Icon.astro';
import BrandLogo from '../components/BrandLogo.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  showPrint?: boolean;
}

const { title, description = 'Um espaço pessoal para registrar ideias, leituras e descobertas.', wide = false, showPrint = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('aletheia-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="author" content="O Eleito" />
    <meta name="copyright" content="© O Eleito" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Aletheia — RSS" href="/rss.xml" />
    <title>{title} · Aletheia</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aletheia" />
    <meta property="og:title" content={`${title} · Aletheia`} />
    <meta property="og:description" content={description} />
  </head>
  <body id="topo">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="header-inner">
        <BrandLogo />
        <nav aria-label="Navegação principal">
          <a class="icon-link" href="/ensaios/"><Icon name="book" /><span>Ensaios</span></a>
          <a class="icon-link" href="/assuntos/"><Icon name="tag" /><span>Assuntos</span></a>
          <button class="theme-toggle icon-link" id="theme-toggle" type="button" aria-label="Alternar tema" aria-pressed="false">
            <Icon name="moon" class="theme-icon-moon" />
            <Icon name="sun" class="theme-icon-sun" />
            <span>Tema</span>
          </button>
          <details class="nav-dropdown" id="nav-dropdown">
            <summary class="icon-link nav-dropdown-trigger" aria-label="Mais opções">
              <span>Mais</span>
              <Icon name="chevron-down" class="dropdown-chevron" />
            </summary>
            <div class="nav-dropdown-menu">
              <a class="icon-link" href="/antologia/"><Icon name="printer" /><span>Antologia</span></a>
              <a class="icon-link" href="/sobre/"><Icon name="user" /><span>Sobre</span></a>
              {showPrint && (
                <button class="theme-toggle icon-link nav-dropdown-btn" id="print-button" type="button" aria-label="Imprimir este ensaio">
                  <Icon name="printer" />
                  <span>Imprimir</span>
                </button>
              )}
            </div>
          </details>
        </nav>
      </div>
    </header>
    <main id="conteudo" class:list={['page-shell', wide && 'page-shell-wide']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-tagline">Um espaço aberto, sem pressa.</span>
        <a class="icon-link contact-email" href="https://mail.google.com/mail/?view=cm&fs=1&to=oeleito.blog@gmail.com" target="_blank" rel="noopener noreferrer"><Icon name="mail" /><span>oeleito.blog@gmail.com</span></a>
      </div>
      <div class="footer-bottom">
        <span class="footer-credit">© O Eleito</span>
      </div>
    </footer>
    <script>
      import '../scripts/theme.ts';
      import '../scripts/print.ts';
    </script>
  </body>
</html>
