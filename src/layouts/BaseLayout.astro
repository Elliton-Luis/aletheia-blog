---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Um espaço pessoal para registrar ideias, leituras e descobertas.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe3" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('aletheia-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Aletheia — RSS" href="/rss.xml" />
    <title>{title} · Aletheia</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Aletheia`} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark icon-link" href="/" aria-label="Aletheia — página inicial">Aletheia<span>.</span><Icon name="spark" /></a>
        <nav aria-label="Navegação principal">
          <a class="icon-link" href="/artigos/"><Icon name="book" /><span>Textos</span></a>
          <a class="icon-link" href="/assuntos/"><Icon name="tag" /><span>Assuntos</span></a>
          <a class="icon-link" href="/sobre/"><Icon name="user" /><span>Sobre</span></a>
          <button class="theme-toggle icon-link" id="theme-toggle" type="button" aria-label="Alternar tema" aria-pressed="false">
            <Icon name="moon" class="theme-icon-moon" />
            <Icon name="sun" class="theme-icon-sun" />
            <span>Tema</span>
          </button>
        </nav>
      </div>
    </header>
    <main id="conteudo" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>Um espaço aberto, sem pressa.</span>
        <a class="icon-link" href="/rss.xml"><Icon name="rss" /><span>RSS</span></a>
        <span class="print-credit">Créditos: O Eleito</span>
      </div>
    </footer>
    <script>
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
